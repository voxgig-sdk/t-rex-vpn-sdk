# Entity: authentication

main: kit: entity: authentication: {

  alias: field: {}

  fields: [
    {
      format: "email"
      name: "email"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "User email address"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      format: "password"
      name: "password"
      req: true
      short: "User password"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "authentication"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/auth/login"
          segments: [
            {
              lit: "auth"
            }
            {
              lit: "login"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.user`"
          }
        }
      ]
    }
  }



}
