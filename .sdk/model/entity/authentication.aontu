# Entity: authentication

main: kit: entity: authentication: {

  alias: field: {}

  fields: {
    email: {
      fo: "email"
      h: "Email"
      n: "email"
      r: true
      sh: "User email address"
      t: "`$STRING`"
    }
    expiry: {
      fo: "date-time"
      h: "Expiry"
      n: "expiry"
      r: false
      sh: "Token expiration time"
      t: "`$STRING`"
    }
    password: {
      fo: "password"
      h: "Password"
      n: "password"
      r: true
      sh: "User password"
      t: "`$STRING`"
    }
    token: {
      h: "Token"
      n: "token"
      r: false
      sh: "Authentication token for VPN access"
      t: "`$STRING`"
    }
    user: {
      h: "User"
      n: "user"
      r: false
      t: "`$OBJECT`"
    }
  }

  name: "authentication"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /auth/login"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/auth/login"
          s: [
            {
              lit: "auth"
            }
            {
              lit: "login"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
